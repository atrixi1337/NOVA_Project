# Secrets — never commit the real key
.env
# SQLite history database (runtime data, persisted via Docker volume or Fly.io volume)
nova_history.db*
nova-test-history.db*
# Python caches
__pycache__/
*.pyc
# Virtualenv (kept on disk, not in git)
nova_env/
.venv/
venv/

# Frontend build deps (the compiled static/ is committed & served by FastAPI)
frontend/node_modules/
node_modules/
frontend/dist/
# Vite cache
frontend/.vite/

# never commit backups or .env variants
*.bak
.env.bak*
