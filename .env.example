# ---- Nova POC configuration ----
# Copy this file to ".env" and fill in your Amazon Nova key.
# The key stays SERVER-SIDE only — it is never sent to the browser.

# REQUIRED: your Amazon Nova API key (the same value you used as the Bearer token)
NOVA_API_KEY=your-nova-key-here

# Optional overrides (sensible defaults shown)
NOVA_BASE_URL=https://api.nova.amazon.com/v1
NOVA_MODEL=nova-2-lite-v1
APP_HOST=0.0.0.0
APP_PORT=8000

# Path the read_file tool is allowed to read from (agent mode sandbox).
# On the lab box this is the Downloads folder; change as needed.
NOVA_SANDBOX=/home/dev/PROJECT/NOVA_Project
