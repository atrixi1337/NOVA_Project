# ---- AI POC configuration ----
# Copy this file to ".env" and fill in the keys you have.
# Keys stay SERVER-SIDE only — they are never sent to the browser.

# Which provider the UI defaults to on load: foundry | gemini | nova
DEFAULT_PROVIDER=foundry

# ---- Amazon Nova (optional) ----
NOVA_API_KEY=your-nova-key-here
NOVA_BASE_URL=https://api.nova.amazon.com/v1
NOVA_MODEL=nova-2-lite-v1

# ---- Azure AI Foundry (optional) ----
FOUNDRY_API_KEY=your-foundry-key-here
FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
FOUNDRY_MODEL=gpt-5-mini
FOUNDRY_MODELS=gpt-5-mini,gpt-4o,gpt-4o-mini

# Google Gemini via OpenAI-compatible endpoint (optional)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash

# ---- Cohere (optional) ----
COHERE_API_KEY=your-cohere-key-here
COHERE_BASE_URL=https://api.cohere.ai/v2
COHERE_MODEL=command-a-plus-05-2026
COHERE_MODELS=command-a-plus-05-2026,command-r7b-12-2024,command-r-plus

# ---- Local Ollama (uncensored local models, no external API key) ----
# Ollama serves an OpenAI-compatible endpoint; the api_key below is IGNORED.
# Set OLLAMA_BASE_URL only if Ollama runs somewhere other than localhost:11434.
# Model names must match `ollama list` on this box.
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=dolphin3.0:8b
OLLAMA_MODELS=dolphin3.0:8b
# Seconds of inactivity before the local model is auto-evicted from VRAM (0 = never auto-unload).
OLLAMA_IDLE_UNLOAD=300

# ---- OpenRouter (free cloud router; openrouter/free auto-routes to a free model) ----
# CLOUD + censored. Useful as a capability fallback when local 8B is too weak.
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MODELS=openrouter/free

# ---- HuggingFace Inference Providers router (free cloud, OpenAI-compatible) ----
# CLOUD + censored. Uses your HF token. Free catalog is limited.
HF_TOKEN=your-huggingface-token-here
HFROUTER_BASE_URL=https://router.huggingface.co/v1
HFROUTER_DEFAULT_MODEL=openai/gpt-oss-20b
HFROUTER_MODELS=openai/gpt-oss-20b,zai-org/GLM-5.2,meta-models/Muse-Glimmer-30B,inclusionAI/Ling-3.0-flash,meta-llama/Llama-3.1-8B-Instruct

# ---- Cloudflare Workers AI (OpenAI-compatible; free 10k neurons/day) ----
# CLOUD + censored. Free tier = 10,000 Neurons/day (resets 00:00 UTC).
# Needs a Cloudflare account ID + API token with Workers AI permission.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/your-cloudflare-account-id/ai/v1
CLOUDFLARE_MODEL=@cf/qwen/qwen3.8-27b
CLOUDFLARE_MODELS=@cf/qwen/qwen3.8-27b,@cf/meta/llama-3.1-8b-instruct,@cf/meta/llama-3.2-3b-instruct

# ---- Mistral AI (OpenAI-compatible; genuine free tier on mistral-small-latest) ----
# CLOUD + censored. Free tier is rate-limited; paid beyond that.
MISTRAL_API_KEY=your-mistral-key-here
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest
MISTRAL_MODELS=mistral-small-latest,mistral-large-latest,open-mistral-7b,ministral-8b-latest


# ---- Requesty (free cloud router; 200 req/day, no card) ----
REQUESTY_BASE_URL=https://router.requesty.ai/v1
REQUESTY_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
REQUESTY_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/muse-glimmer-30b,novita/inclusionai/ling-3.0-tiny

# ---- server / sandbox ----
APP_HOST=0.0.0.0
APP_PORT=8000
# SQLite database for chat history (file-based). In Docker/K8s this sits on a
# persistent volume; locally it defaults to ./nova_history.db.
NOVA_HISTORY_DB=nova_history.db
# Path the read_file tool is allowed to read from (agent mode sandbox).
NOVA_SANDBOX=/home/dev/PROJECT/NOVA_Project

# ---- Upstage AI (OpenAI-compatible; supports reasoning_effort) ----
UPSTAGE_API_KEY=your-upstage-key-here
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_MODEL=solar-pro4
UPSTAGE_MODELS=solar-pro4

# ---- Inception Labs (OpenAI-compatible) ----
INCEPTION_API_KEY=your-inception-key-here
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_MODEL=mercury-2
INCEPTION_MODELS=mercury-2

# ---- GMI Cloud (OpenAI-compatible; MiniMax M-series) ----
GMI_API_KEY=your-gmi-key-here
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_MODEL=MiniMaxAI/MiniMax-M3
GMI_MODELS=MiniMaxAI/MiniMax-M3,MiniMaxAI/MiniMax-M2.7,MiniMaxAI/MiniMax-M2.5,MiniMaxAI/MiniMax-M2.1

# ---- Agnes AI (OpenAI-compatible; Bearer auth) ----
AGNES_API_KEY=your-agnes-key-here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-pro
AGNES_MODELS=agnes-2.5-pro,agnes-2.5-pro-beta,agnes-2.5-flash

# ---- IFM AI K2 Horizon (OpenAI-compatible; reasoning via chat_template_kwargs) ----
IFM_API_KEY=your-ifm-key-here
IFM_BASE_URL=https://api.ifm.ai/v1
IFM_MODEL=IFM/K2-Horizon-375B-A23B
IFM_MODELS=IFM/K2-Horizon-375B-A23B

# (backup Gemini key for 403->200 failover)
GEMINI_API_KEY_BACKUP=your-gemini-backup-key-here
REQUESTY_API_KEY=your-requesty-key-here

# ---- Reka AI (OpenAI-compatible; uses the X-Api-Key header) ----
REKA_API_KEY=your-reka-key-here
REKA_BASE_URL=https://api.reka.ai/v1
REKA_MODEL=deepseek4-flash
REKA_MODELS=reka-edge-2603,deepseek4-flash,glm5.3-flash,glm5.2,qwen3.8-flash,qwen3.8-27b

# ---- NVIDIA NIM / API Catalog (OpenAI-compatible; Bearer nvapi- key) ----
# https://integrate.api.nvidia.com/v1  Vision-capable (image_url) + chat models.
NVIM_API_KEY=your-nvapi-key-here
NVIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIM_MODEL=nvidia/nemotron-4-340b-instruct
# Curated from the live /v1/models catalog (incl. vision models for image input).
NVIM_MODELS=nvidia/nemotron-4-340b-instruct,nvidia/llama-3.1-nemotron-70b-instruct,nvidia/llama-3.1-nemotron-ultra-253b-v1,nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,nvidia/nemotron-3-super-120b-a12b,meta/llama-3.2-90b-vision-instruct,meta/llama-3.2-11b-vision-instruct,microsoft/phi-3-vision-128k-instruct,mistralai/mistral-large,mistralai/mistral-nemotron,moonshotai/kimi-k2.6,deepseek-ai/deepseek-v4-pro-0813,ibm/granite-34b-code-instruct
